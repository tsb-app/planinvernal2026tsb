function upd() {
  const p = Math.round(S.done.size / TOPICS.length * 100);
  document.getElementById('prog').style.width = p + '%';
  document.getElementById('prog-lbl').textContent = S.done.size + ' de ' + TOPICS.length + ' tópicos completados';
