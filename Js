// PERSISTENCIA — Guardar y recuperar progreso
// =============================================
const STORAGE_KEY = 'planinvernal2026_progress';

function saveProgress() {
  try {
    const data = {
      u: S.u,
      done: [...S.done],
      ac: S.ac,
      as: S.as,
      af: S.af,
      certified: S.certified || false,
      score: (S.score !== null && S.score !== undefined) ? S.score : null,
      ts: Date.now()
    };
    localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
  } catch(e) {}
}

function loadProgress() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) return false;
    const data = JSON.parse(raw);
    // Expire after 90 days
    if (Date.now() - data.ts > 90 * 24 * 60 * 60 * 1000) {
      localStorage.removeItem(STORAGE_KEY);
      return false;
    }
    if (data.u) {
      S.u = data.u;
      S.done = new Set(data.done || []);
      S.ac = data.ac || {};
      S.as = data.as || {};
      S.af = data.af || {};
      S.certified = data.certified || false;
      S.score = (data.score !== undefined && data.score !== null) ? data.score : null;
      S.sc = S.certified ? 'cert' : 'menu';
      return true;
    }
  } catch(e) {}
  return false;
}

function clearProgress() {
  try { localStorage.removeItem(STORAGE_KEY); } catch(e) {}
}

