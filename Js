const API_URL = 'https://script.google.com/macros/s/AKfycbzYuH1mbx-MpA0JOc_B43SikH0-1hq-ytV2sI68opV-_GyI_IQxZxRVnqQSdWNUcdt_QA/exec';

async function trackProgress(action) {
  if (!S.u) return;
  const topicsDetail = [...S.done].join(',');
  const pct = Math.round((S.done.size / TOPICS.length) * 100);
  const estado = S.certified ? 'Certificado' : S.done.size > 0 ? 'En progreso' : 'Iniciado';
  
  const payload = {
    dni: S.u.dn,
    nombre: S.u.fn,
    apellido: S.u.ln,
    uo: S.u.uo || '',
    empresa: S.u.empresa || '',
    topicos_completados: S.done.size,
    porcentaje: pct,
    topicos_detalle: topicsDetail,
    estado: estado,
    puntaje: S.certified ? (S.score * 10) + '%' : '',
    fecha_inicio: S.u.date,
    fecha_cert: S.certified ? S.u.date : ''
  };

  try {
    // no-cors + NO headers = no preflight = works with Apps Script
    const formData = new FormData();
    formData.append('data', JSON.stringify(payload));
    
    await fetch(API_URL, {
      method: 'POST',
      mode: 'no-cors',
      body: formData
    });
  } catch(e) {
    console.log('API sync error (non-blocking):', e);
  }
}

