  const certBtn = S.certified ? '<a href="certificado.html?' + new URLSearchParams({name: S.u.fn+' '+S.u.ln, dni: S.u.dn, uo: S.u.uo||'', empresa: S.u.empresa||'', date: S.u.date, score: S.score||0, pct: (S.score||0)*10}).toString() + '" target="_blank" style="background:#185FA5;color:#fff;text-decoration:none;border-radius:6px;padding:5px 12px;font-size:12px;font-weight:600;white-space:nowrap">🏆 Ver certificado</a>' : '';
  const banner = document.createElement('div');
  banner.style.cssText = 'background:#EAF3DE;border:1px solid #C0DD97;border-radius:8px;padding:10px 16px;margin-bottom:12px;font-size:13px;color:#27500A;display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap';
  banner.innerHTML = '<span>👋 Bienvenido/a de vuelta <strong>' + S.u.fn + '</strong>. ' + (S.certified ? '🥇 Plan completado con <strong>' + (S.score||0)*10 + '%</strong>' : 'Retomás desde donde dejaste (' + S.done.size + ' de 9 tópicos completados)') + '</span><div style="display:flex;gap:8px;align-items:center">' + certBtn + '<button onclick="this.parentElement.parentElement.remove()" style="background:transparent;border:none;cursor:pointer;font-size:16px;color:#3B6D11">✕</button></div>';
  document.querySelector('.app').insertBefore(banner, document.getElementById('main'));
  render();
} else {
  render();
}
