function render() {
  const m = document.getElementById('main');
  if (S.sc === 'reg') rReg(m);
  else if (S.sc === 'menu') rMenu(m);
  else if (S.sc === 'topic') rTopic(m);
  else if (S.sc === 'eval') rEval(m);
  else if (S.sc === 'cert') rCert(m);
}

