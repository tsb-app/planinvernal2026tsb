// ---- ACTIVITY ----
function rAct(t) {
  const a = t.act;
  if (!a) return '';
  const ck = S.af[t.id];
  const sel = S.as[t.id];
  const letters = ['A', 'B', 'C', 'D'];
  let h = `<div class="act">
    <div class="act-hdr">🎯 Actividad — verificá tu comprensión</div>
    <p>Respondé correctamente para habilitar el botón de completado.</p>
    <div class="act-q">${a.q}</div>`;

  a.opts.forEach((o, i) => {
    let c = '';
    if (ck) c = i === a.ans ? 'ok' : (sel === i && sel !== a.ans ? 'ng' : '');
    else c = sel === i ? 'sel' : '';
    h += `<div class="ao ${c}" onclick="${ck ? '' : 'aSel(\'' + t.id + '\',' + i + ')'}">
      <span class="ao-ltr">${ck ? (i === a.ans ? '✓' : (sel === i ? '✗' : letters[i])) : (sel === i ? '●' : letters[i])}</span>
      ${o}
    </div>`;
  });

  if (!ck) {
    h += `<button class="act-btn" onclick="chkAct('${t.id}')" ${sel !== undefined ? '' : 'disabled'}>Verificar respuesta</button>`;
  }
  if (ck) {
    const ok = S.as[t.id] === a.ans;
    h += `<div class="afb ${ok ? 'ok' : 'ng'}">${ok ? '✓ ' + a.ok : '✗ ' + a.ng}</div>`;
    if (!ok) h += `<button class="act-btn retry-btn" onclick="retryAct('${t.id}')">↺ Intentar de nuevo</button>`;
  }
  h += '</div>';
  return h;
}

function aSel(id, i) { S.as[id] = i; render(); }

function chkAct(id) {
  const t = TOPICS.find(x => x.id === id);
  S.af[id] = true;
  if (S.as[id] === t.act.ans) {
    S.ac[id] = true;
    const b = document.getElementById('db-' + id);
    if (b) b.disabled = false;
  }
  render();
}

function retryAct(id) {
  delete S.af[id]; delete S.as[id]; delete S.ac[id];
  render();
}

function mDone(id) {
  if (!S.ac[id]) return;
  S.done.add(id);
  S.sc = 'menu';
  saveProgress();
  trackProgress('topico');
  render();
}

function gMenu() { S.sc = 'menu'; render(); }
function gMenuFromCert() { S.sc = 'menu'; render(); }

// ---- EVALUATION ----
function oEval() {
  if (S.done.size < TOPICS.length) return;
  S.sc = 'eval'; S.ea = {}; S.es = false; S.er = null;
  render(); window.scrollTo(0, 0);
}

function rEval(el) {
  const answered = Object.keys(S.ea).length;
  let h = `<button class="back-btn" onclick="gMenu()">← Volver al menú</button>
  <div class="ev">
    <div class="ev-hdr">
      <h2>📝 Evaluación final — Plan Invernal 2026</h2>
      <p>Debés responder correctamente al menos <strong>8 de 10 preguntas</strong> (80%) para obtener tu certificado${S.ei > 0 ? ' · Intento #' + (S.ei + 1) : ''}</p>
      ${!S.es ? `<p class="ev-prog">Respondidas: <span>${answered}</span> de ${QUESTIONS.length}</p>` : ''}
    </div>`;

  if (S.es && S.er !== null) {
    if (S.er) {
      const sc = QUESTIONS.filter((q, i) => S.ea[i] === q.ans).length;
      h += `<div class="rb pass"><h3>¡Aprobaste! 🎉</h3><p>Respondiste ${sc} de 10 correctamente (${sc*10}%). ¡Excelente trabajo!</p></div>`;
      h += `<button class="sub-btn" onclick="gCert()">🏆 Obtener mi certificado</button>`;
    } else {
      const c = QUESTIONS.filter((_, i) => S.ea[i] === QUESTIONS[i].ans).length;
      const attLeft = 3 - S.ei;
      h += `<div class="rb fail"><h3>No alcanzaste el 80% requerido</h3><p>Respondiste ${c} de 10 correctamente (${c*10}%). Necesitás al menos 8 correctas.${attLeft > 0 ? ` Te quedan <strong>${attLeft} intento(s)</strong>.` : ' <strong>No quedan más intentos.</strong> Contactá a tu supervisor.'}</p></div>`;
    }
  }

  QUESTIONS.forEach((q, qi) => {
    const sel = S.ea[qi], sub = S.es;
    const letters = ['A', 'B', 'C', 'D'];
    h += `<div class="qb">
      <div class="qn">Pregunta ${qi + 1} de ${QUESTIONS.length}</div>
      <div class="qt">${q.q}</div>`;
    q.opts.forEach((o, oi) => {
      let c = '';
      if (sub) c = oi === q.ans ? 'ok' : ''; // Only highlight correct, not wrong
      else c = sel === oi ? 'sel' : '';
      h += `<div class="ao ${c}" onclick="${sub ? '' : 'eSel(' + qi + ',' + oi + ')'}">
        <span class="ao-ltr">${sub ? (oi === q.ans ? '✓' : letters[oi]) : (sel === oi ? '●' : letters[oi])}</span>
        ${letters[oi]}. ${o}
      </div>`;
    });
    h += '</div>';
  });

  if (!S.es) {
    const all = Object.keys(S.ea).length === QUESTIONS.length;
    h += `<button class="sub-btn" ${all ? '' : 'disabled'} onclick="subEv()">${all ? 'Enviar respuestas' : 'Respondé todas las preguntas para continuar'}</button>`;
  } else if (!S.er) {
    if (S.ei < 3) {
      h += `<button class="sub-btn" onclick="retryEv()">🔄 Volver a intentar (intento ${S.ei + 1} de 3)</button>`;
    } else {
      h += `<div style="text-align:center;padding:1rem;font-size:13px;color:var(--danger-tx)">Agotaste los 3 intentos. Por favor contactá a tu supervisor.</div>`;
    }
  }
  h += '</div>';
  el.innerHTML = h;
}

function eSel(qi, oi) { S.ea[qi] = oi; render(); }

function subEv() {
  S.es = true;
  const correct = QUESTIONS.filter((q, i) => S.ea[i] === q.ans).length;
  S.er = correct >= 8; // 80% - 8 out of 10
  S.score = correct;
  if (!S.er) S.ei++;
  render(); window.scrollTo(0, 0);
}

function retryEv() { if (S.ei >= 3) return; S.ea = {}; S.es = false; S.er = null; render(); }

function gCert() { 
  S.sc = 'cert';
  S.certified = true;
  saveProgress();
  trackProgress('certificado');
  render(); 
  window.scrollTo(0, 0);
  if (S.u) submitToForms(S.u);
}

