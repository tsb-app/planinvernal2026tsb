function submitToForms(user) {
  const FORM_ID = '1FAIpQLSdZsWi0iARR3kdqe3tj69d4bLCTGFTdEtl-8QGJAIhPyZlx-Q';
  const BASE_URL = 'https://docs.google.com/forms/d/e/' + FORM_ID + '/formResponse';
  
  const progressPct = Math.round((S.done.size / 9) * 100);
  const params = new URLSearchParams({
    'entry.1341209651': user.fn,
    'entry.1026852883': user.ln,
    'entry.1915930370': user.dn,
    'entry.2005130874': user.uo,
    'entry.2078018585': user.date,
    // Note: add 'empresa' field to Google Form and replace EMPRESA with its entry ID
    // 'entry.XXXXXXXX': user.empresa || '',
    'submit': 'Submit'
  });
  
  // Method 1: fetch no-cors
  fetch(BASE_URL, {
    method: 'POST',
    mode: 'no-cors',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: params.toString()
  }).catch(() => {});
  
  // Method 2: hidden iframe fallback
  try {
    const iframe = document.createElement('iframe');
    iframe.style.display = 'none';
    document.body.appendChild(iframe);
    const form = iframe.contentDocument.createElement('form');
    form.method = 'POST';
    form.action = BASE_URL;
    params.forEach((v, k) => {
      const input = iframe.contentDocument.createElement('input');
      input.type = 'hidden'; input.name = k; input.value = v;
      form.appendChild(input);
    });
    iframe.contentDocument.body.appendChild(form);
    form.submit();
    setTimeout(() => { try { document.body.removeChild(iframe); } catch(e){} }, 3000);
  } catch(e) {}
}


